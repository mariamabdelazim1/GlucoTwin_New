{
  "name": "glucotwin-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "services/api"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace services/api run dev",
    "db:migrate": "npm --workspace services/api run db:migrate",
    "db:seed": "npm --workspace services/api run db:seed",
    "db:import": "npm --workspace services/api run db:import --",
    "build:web": "npm --workspace apps/web run build",
    "test:api": "npm --workspace services/api test",
    "test:web:integration": "npm --workspace services/api run db:migrate:test && npm --workspace services/api run db:seed:test && npm --workspace apps/web run test:integration"
  }
}
