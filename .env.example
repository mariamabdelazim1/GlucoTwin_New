# Development database created by compose.yaml
POSTGRES_PASSWORD=local-glucotwin-password
DATABASE_URL=postgresql://glucotwin:local-glucotwin-password@127.0.0.1:5432/glucotwin

# Dedicated test database. The test runner refuses names without `_test`.
TEST_DATABASE_URL=postgresql://glucotwin:local-glucotwin-password@127.0.0.1:5432/glucotwin_test

# Use a long random value outside local development.
TOKEN_SECRET=replace-with-a-long-random-secret

SYNC_HOST=127.0.0.1
SYNC_PORT=8787
CORS_ORIGIN=http://127.0.0.1:5173

